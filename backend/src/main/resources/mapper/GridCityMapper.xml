<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.GridCityMapper">

    <select id="listGridCityByProvinceId" parameterType="com.example.entity.GridCity">
        select * from grid_city where province_id = #{provinceId}
    </select>

</mapper>
